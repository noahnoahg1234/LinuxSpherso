#!/bin/sh
# The installer removes live-session packages from the installed system with
# "apt-get remove <list>". apt aborts the whole command (error 100, "Installation
# Failed") if any listed package is unknown, and the live image has no apt lists,
# so drop every package from the list that isn't actually installed here.
F="${1:-/etc/calamares/modules/packages.conf}"
[ -f "$F" ] || exit 0
for p in $(sed -n "s/^\s*-\s*'\{0,1\}\([a-z0-9][a-z0-9.+-]*\)'\{0,1\}\s*$/\1/p" "$F" | sort -u); do
  dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' && continue
  echo "Installer: not removing $p (not installed)"
  sed -i "/^\s*-\s*'\{0,1\}$p'\{0,1\}\s*$/d" "$F"
done
exit 0
