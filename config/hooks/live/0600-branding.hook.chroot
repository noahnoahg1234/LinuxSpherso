#!/bin/sh
[ -f /etc/build-proxy.sh ] && . /etc/build-proxy.sh
set -e
cat > /etc/os-release <<R
PRETTY_NAME="LinuxSpherso 1.0 (Glass)"
NAME="LinuxSpherso"
VERSION_ID="1.0"
VERSION="1.0 (Glass)"
VERSION_CODENAME=trixie
ID=linuxspherso
ID_LIKE=debian
HOME_URL="https://github.com/linuxspherso"
LOGO=linuxsphere-start
R
rm -f /usr/lib/os-release; cp /etc/os-release /usr/lib/os-release
cat > /etc/lsb-release <<R
DISTRIB_ID=LinuxSpherso
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=glass
DISTRIB_DESCRIPTION="LinuxSpherso 1.0 (Glass)"
R
echo "LinuxSpherso 1.0 \\n \\l" > /etc/issue
echo linuxsphere > /etc/hostname
# keep os-release on upgrades of base-files
dpkg-divert --local --rename --add /usr/lib/os-release 2>/dev/null || true
# Plymouth boot splash
plymouth-set-default-theme spinner || true
# GRUB theme for the installed system
update-grub 2>/dev/null || true
# Default Plasma look & feel + SDDM
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-linuxsphere.conf <<R
[Theme]
Current=breeze
[General]
DisplayServer=wayland
R
install -d /usr/share/sddm/themes/breeze
cat > /usr/share/sddm/themes/breeze/theme.conf.user <<R
[General]
background=/usr/share/wallpapers/LinuxSphere/contents/images/3840x2160.png
type=image
R
# Refresh icon caches so the custom start-menu icon is found
gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/Papirus-Dark 2>/dev/null || true
# Snap Store first-boot service
systemctl enable linuxsphere-firstboot.service || true
systemctl enable snapd.socket snapd.apparmor.service || true
# Docker group for users created by the installer
groupadd -f docker
